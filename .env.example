# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
MODE=PROD
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,server
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
WEB_CONCURRENCY=2

# Postgres
DB_USER=aspire_user
DB_PASS=change-me

# MinIO / S3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio

# RabbitMQ
RABBITMQ_USER=aspire
RABBITMQ_PASS=change-me

# Flower
FLOWER_USER=flower
FLOWER_PASS=change-me

# Nginx basic auth for RabbitMQ / MinIO consoles (htpasswd user)
NGINX_ADMIN_USER=admin
NGINX_ADMIN_PASS=change-me

# Celery
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=720

# TLS / certbot (production)
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=noreply@example.com
